# Frontend (Vite)
# Base URL for broker/API requests from the web app.
# Example: http://localhost:8787
VITE_BROKER_BASE_URL=

# Enables AI developer mode controls in the UI when set to true.
# true | false
VITE_AI_DEVELOPER_MODE=false

# Local broker/server environment variables
# Used by src/server/integrationBroker.ts for /api/chat provider proxying.
BROKER_GROQ_API_KEY=
BROKER_OPENROUTER_API_KEY=
BROKER_GEMINI_API_KEY=

# Used by src/server/integrationBroker.ts for /api/ai/generate.
BROKER_OPENAI_API_KEY=
