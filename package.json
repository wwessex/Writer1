{
  "name": "draftharbour-studio",
  "version": "2.0.0",
  "type": "module",
  "description": "Offline-first Progressive Web Application for writing novels",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:native": "npm run build && npx cap sync",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:inventory": "node scripts/test-inventory.mjs",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:doctor": "npx cap doctor",
    "prepare": "husky",
    "bundle:analyze": "npm run build && node scripts/check-bundle-size.mjs",
    "bundle:check": "node scripts/check-bundle-size.mjs --ci",
    "assets:check": "node scripts/check-asset-duplicates.mjs",
    "test:coverage": "vitest run --coverage.enabled",
    "coverage:changed": "node scripts/check-touched-coverage.mjs",
    "verify:vite-config": "node scripts/verify-vite-config.mjs",
    "ci": "npm run lint && npm run typecheck && npm run verify:vite-config && npm run test:coverage && npm run build && npm run bundle:check && npm run assets:check",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run build",
    "desktop:build:debug": "npm --prefix desktop run build:debug",
    "desktop:build:mac": "npm --prefix desktop run build -- --target universal-apple-darwin",
    "desktop:build:win": "npm --prefix desktop run build -- --target x86_64-pc-windows-msvc",
    "desktop:build:linux": "npm --prefix desktop run build -- --target x86_64-unknown-linux-gnu",
    "release:verify-artifacts": "node scripts/verify-release-artifacts.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "@lezer/markdown": "^1.6.3",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "dexie": "^4.0.8",
    "docx": "^9.5.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.575.0",
    "pdfmake": "^0.2.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.2.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0"
    ]
  },
  "devDependencies": {
    "@capacitor/cli": "^8.1.0",
    "@eslint/js": "^9.17.0",
    "@tauri-apps/api": "^2.2.0",
    "@types/pdfmake": "^0.2.9",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.2.7",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.0.18",
    "workbox-window": "^7.3.0"
  }
}
